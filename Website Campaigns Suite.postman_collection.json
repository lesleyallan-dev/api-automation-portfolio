      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verify the server created the record",
              "pm.test(\"Lead created successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Automation: Extract the ID from the response and save it",
              "var responseData = pm.response.json();",
              "pm.environment.set(\"latest_lead_id\", responseData.id);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
